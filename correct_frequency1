#define TIMER_CLK   100000.0f   // HSI 8MHz / (PSC79+1) = 100kHz
#define PPR         1           // pulses per revolution

#define AVG_LOW     4
#define AVG_MID     16
#define AVG_HIGH    64
#define AVG_MAX     64

#define MA_WINDOW   10
#define MED_SIZE    5
#define FIR_TAPS    5
/* USER CODE END PD */

